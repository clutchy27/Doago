generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String      @id @default(cuid())
  ime                String
  email              String      @unique
  geslo              String
  vloga              String      @default("narocnik")
  createdAt          DateTime    @default(now())
  nalogaKotNarocnik  Naloga[]    @relation("NarocnikNaloge")
  nalogaKotIzvajalec Naloga[]    @relation("IzvajalecNaloge")
  sporocila          Sporocilo[]
  spPodatki          SpPodatki?
}

model SpPodatki {
  id             String   @id @default(cuid())
  ime            String
  priimek        String
  davcnaStevilka String   @unique
  iban           String
  naslov         String
  opis           String?
  kategorije     String   @default("")
  mesta          String   @default("")
  profilUrejen   Boolean  @default(false)
  skupniZasluzek Float    @default(0)
  steviloOcen    Int      @default(0)
  povprecnaOcena Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id])
  userId         String   @unique
}

model Naloga {
  id          String      @id @default(cuid())
  naslov      String
  opis        String
  cena        Float
  kategorija  String
  lokacija    String
  status      String      @default("odprta")
  nujna         Boolean     @default(false)
  profesionalna Boolean     @default(false)
  createdAt     DateTime    @default(now())
  narocnik    User        @relation("NarocnikNaloge", fields: [narocnikId], references: [id])
  narocnikId  String
  izvajalec   User?       @relation("IzvajalecNaloge", fields: [izvajalecId], references: [id])
  izvajalecId String?
  sporocila   Sporocilo[]
}

model Sporocilo {
  id        String   @id @default(cuid())
  besedilo  String
  createdAt DateTime @default(now())
  avtor     User     @relation(fields: [avtorId], references: [id])
  avtorId   String
  naloga    Naloga   @relation(fields: [nalogaId], references: [id])
  nalogaId  String
}
